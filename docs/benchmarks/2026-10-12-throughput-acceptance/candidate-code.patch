+static void
+test_append_row_staging_admission(void)
+{
+    const struct {
+        uint32_t width;
+        bool governed;
+        bool full;
+    } cases[] = {
+        { 16u, true, false },
+        { 17u, true, false },
+        { 17u, false, false },
+        { 17u, true, true },
+    };
+
+    for (size_t test = 0; test < sizeof(cases) / sizeof(cases[0]); test++) {
+        uint32_t width = cases[test].width;
+        uint32_t rows = cases[test].full ? COL_REL_INIT_CAP : 17u;
+        wl_columnar_memory_resolution_t resolution;
+        wl_columnar_memory_governor_ref_t *ref = NULL;
+        wl_columnar_memory_governor_t *governor = NULL;
+        col_rel_t *rel = col_rel_new_auto("staging", width);
+        int64_t row[17];
+        int64_t image[17][COL_REL_INIT_CAP];
+        int64_t expected[17];
+
+        CHECK(rel != NULL, "aliased append staging fixture");
+        if (!rel)
+            continue;
+        for (uint32_t i = 0; i < rows; i++) {
+            for (uint32_t c = 0; c < width; c++)
+                row[c] = (int64_t)c * 1000 + i;
+            CHECK(col_rel_append_row(rel, row) == 0,
+                "nonoverlapping append staging setup");
+        }
+        if (cases[test].governed) {
+            make_resolution(&resolution, 1024u * 1024u);
+            ref = wl_columnar_memory_governor_ref_create(&resolution);
+            CHECK(ref && col_rel_attach_memory_governor(rel, ref) == 0,
+                "aliased append staging governor attach");
+            if (!ref || rel->memory_governor != ref)
+                goto cleanup;
+            governor = wl_columnar_memory_governor_ref_get(ref);
+        }
+        CHECK(rel->capacity == COL_REL_INIT_CAP && rel->nrows == rows,
+            "staging fixture has the intended spare or full capacity");
+        for (uint32_t c = 0; c < width; c++)
+            memcpy(image[c], rel->columns[c], rows * sizeof(*row));
+        /* All input values are live, contiguous elements of column zero. */
+        memcpy(expected, rel->columns[0], width * sizeof(*row));
+        uint64_t baseline = governor
+            ? wl_columnar_memory_reserved(governor) : 0;
+        uint64_t retained = rel->retained_reserved_bytes;
+        uint64_t metadata = rel->metadata_reserved_bytes;
+        uint64_t descriptor = rel->descriptor_reserved_bytes;
+        uint64_t storage_generation = rel->storage_generation;
+        uint64_t view_generation = rel->view_generation;
+        int64_t **columns = rel->columns;
+
+        if (governor && width > 16u) {
+            uint64_t scratch = width * sizeof(*row);
+            /* With spare capacity, deny only staging by one byte. With a
+             * full relation, admit staging exactly and deny later growth. */
+            atomic_store_explicit(&governor->usable_bytes,
+                baseline + scratch - (cases[test].full ? 0u : 1u),
+                memory_order_release);
+            CHECK(col_rel_append_row(rel, rel->columns[0]) == ENOMEM
+                && rel->memory_budget_denial_pending,
+                "aliased append preserves the actual staging or growth denial");
+            CHECK(rel->nrows == rows && rel->capacity == COL_REL_INIT_CAP
+                && rel->columns == columns
+                && rel->storage_generation == storage_generation
+                && rel->view_generation == view_generation
+                && rel->retained_reserved_bytes == retained
+                && rel->metadata_reserved_bytes == metadata
+                && rel->descriptor_reserved_bytes == descriptor
+                && wl_columnar_memory_reserved(governor) == baseline,
+                "denial preserves storage and releases any admitted staging credit");
+            for (uint32_t c = 0; c < width; c++)
+                CHECK(memcmp(rel->columns[c], image[c],
+                    rows * sizeof(*row)) == 0,
+                    "aliased append denial preserves all original rows");
+            atomic_store_explicit(&governor->usable_bytes,
+                cases[test].full ? 1024u * 1024u : baseline + scratch,
+                memory_order_release);
+        } else if (governor) {
+            /* Inline staging needs no temporary governor credit. */
+            atomic_store_explicit(&governor->usable_bytes, baseline,
+                memory_order_release);
+        }
+        CHECK(col_rel_append_row(rel, rel->columns[0]) == 0
+            && rel->nrows == rows + 1u
+            && !rel->memory_budget_denial_pending,
+            "aliased append succeeds at its staging boundary or after retry");
+        for (uint32_t c = 0; c < width; c++) {
+            CHECK(memcmp(rel->columns[c], image[c],
+                rows * sizeof(*row)) == 0,
+                "aliased append preserves prior column values");
+            CHECK(rel->columns[c][rows] == expected[c],
+                "aliased append snapshots the complete input before publication");
+        }
+        if (governor)
+            CHECK(wl_columnar_memory_reserved(governor)
+                == rel->retained_reserved_bytes + rel->metadata_reserved_bytes
+                + rel->descriptor_reserved_bytes,
+                "successful aliased append retains no temporary staging credit");
+cleanup:
+        col_rel_destroy(rel);
+        if (ref) {
+            CHECK(wl_columnar_memory_reserved(
+                    wl_columnar_memory_governor_ref_get(ref)) == 0,
+                "aliased append staging fixture releases all credit");
+            wl_columnar_memory_governor_ref_release(ref);
+        }
+    }
+}
