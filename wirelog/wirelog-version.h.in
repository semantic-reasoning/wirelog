        (WIRELOG_VERSION_MAJOR * 10000 + WIRELOG_VERSION_MINOR * 100 \
        + WIRELOG_VERSION_PATCH)

/* Full version string including any pre-release suffix (e.g. "0.40.0-rc1").
 * The integer macros above strip the suffix and reflect the release-line
 * triple only. */
