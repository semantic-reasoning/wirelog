#ifndef WIRELOG_VERSION_H
#define WIRELOG_VERSION_H

#define WIRELOG_VERSION_MAJOR @WIRELOG_VERSION_MAJOR@
#define WIRELOG_VERSION_MINOR @WIRELOG_VERSION_MINOR@
#define WIRELOG_VERSION_PATCH @WIRELOG_VERSION_PATCH@

/* Encoded integer triple, suitable for #if WIRELOG_VERSION >= ... checks.
 * MAJOR * 10000 + MINOR * 100 + PATCH allows minor up to 99 and patch up
 * to 99 between major bumps; the project's release cadence stays well
 * within those bounds. */
